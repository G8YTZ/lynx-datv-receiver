+// FFmpeg 8 removed AVCodec.pix_fmts, .sample_fmts and .ch_layouts; their
+// replacement, avcodec_get_supported_config(), arrived in libavcodec
+// 61.13 (FFmpeg 7.1). Same lists, same sentinels, NULL still meaning
+// "anything". Lynx patch (patches/wf-recorder-0.6.0-ffmpeg8.patch).
+#if LIBAVCODEC_VERSION_INT >= AV_VERSION_INT(61, 13, 100)
+static const void *wfr_codec_config(const AVCodec *codec, enum AVCodecConfig cfg)
+{
+    const void *out = NULL;
+    int n = 0;
+    if (avcodec_get_supported_config(NULL, codec, cfg, 0, &out, &n) < 0)
+        return NULL;
+    return out;
+}
+#define WFR_PIX_FMTS(c) ((const enum AVPixelFormat *)wfr_codec_config((c), AV_CODEC_CONFIG_PIX_FORMAT))
+#define WFR_SAMPLE_FMTS(c) ((const enum AVSampleFormat *)wfr_codec_config((c), AV_CODEC_CONFIG_SAMPLE_FORMAT))
+#define WFR_CH_LAYOUTS(c) ((const AVChannelLayout *)wfr_codec_config((c), AV_CODEC_CONFIG_CHANNEL_LAYOUT))
+#else
+#define WFR_PIX_FMTS(c) ((c)->pix_fmts)
+#define WFR_SAMPLE_FMTS(c) ((c)->sample_fmts)
+#define WFR_CH_LAYOUTS(c) ((c)->ch_layouts)
+#endif
+
