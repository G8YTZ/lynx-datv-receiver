diff --git a/src/main.cpp b/src/main.cpp
index 8ff65f9..f4bb7a0 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -1308,6 +1308,31 @@ int main(int argc, char *argv[])
         }
     }
 
+    // Lynx: Rockchip MPP encoders (h264_rkmpp, hevc_rkmpp) take DMA-BUF
+    // frames directly as DRM_PRIME. The compositor copies each frame into
+    // a GPU buffer and the encoder reads that buffer: no read-back through
+    // the CPU, which at 4K held labwc at 85% and made the screen judder
+    // (ROCK 5C, 11 Nov 2026). Falls back to copying if it cannot be set up.
+    else if (params.codec.find("rkmpp") != std::string::npos && !force_no_dmabuf)
+    {
+        if (params.hw_device.empty())
+            params.hw_device = drm_device_name;
+        if (!params.hw_device.empty())
+            drm_fd = open(params.hw_device.c_str(), O_RDWR);
+        if (drm_fd >= 0)
+            gbm_device = gbm_create_device(drm_fd);
+        if (gbm_device) {
+            use_dmabuf = true;
+            use_hwupload = false;
+            params.drm_prime = true;
+            std::cerr << "rkmpp: DMA-BUF capture, device " << params.hw_device << std::endl;
+        } else {
+            std::cerr << "rkmpp: no DMA-BUF capture (device '" << params.hw_device
+                      << "'), copying frames instead" << std::endl;
+            params.hw_device.clear();
+        }
+    }
+
     check_has_protos();
     load_output_info();
 
