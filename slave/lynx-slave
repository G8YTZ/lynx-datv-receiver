#!/bin/bash
# Reads /etc/lynx-slave.conf, works out which tuner is plugged in, and
# starts the matching source. Installed by slave/install.sh — edit the
# conf, not this.
set -euo pipefail

CONF=/etc/lynx-slave.conf
[ -r "$CONF" ] || { echo "Cannot read $CONF" >&2; exit 1; }
# shellcheck disable=SC1090
. "$CONF"

: "${LYNX_HOST:?LYNX_HOST not set in $CONF}"
: "${FREQ:?FREQ not set in $CONF}"
: "${SR:?SR not set in $CONF}"

ARGS=("$LYNX_HOST" --freq "$FREQ" --sr "$SR")
[ -n "${NAME:-}" ]         && ARGS+=(--name "$NAME")
[ -n "${LOCATOR:-}" ]      && ARGS+=(--locator "$LOCATOR")
[ -n "${STATUS_PORT:-}" ]  && ARGS+=(--status-port "$STATUS_PORT")
[ -n "${VIDEO_PORT:-}" ]   && ARGS+=(--video-port "$VIDEO_PORT")
[ -n "${QUALITY_PORT:-}" ] && ARGS+=(--quality-port "$QUALITY_PORT")
[ -n "${INTERVAL:-}" ]     && ARGS+=(--interval "$INTERVAL")
[ -n "${TRANSPORT:-}" ]    && ARGS+=(--transport "$TRANSPORT")
[ -n "${SRT_PORT:-}" ]     && ARGS+=(--srt-port "$SRT_PORT")
[ -n "${SRT_LATENCY:-}" ]  && ARGS+=(--srt-latency "$SRT_LATENCY")
[ -n "${KEY:-}" ]          && ARGS+=(--key "$KEY")

# From the repo checkout, so a git pull updates the Slave. LYNX_SLAVE_DIR
# in the conf points elsewhere if the checkout lives somewhere else.
SLAVE_DIR="${LYNX_SLAVE_DIR:-/home/pi/lynx-datv-receiver/slave}"

# Which tuner is on the end of the USB cable. Done at every start rather
# than once at install, so swapping a Minitiouner for a Knucker needs a
# service restart and nothing else.
#
# TUNER in the conf overrides it, for the case detection has not met
# yet. If detection cannot run at all - no python, missing file - fall
# back to the Minitiouner rather than failing: every Remote Rx built so
# far is one, and a wrapper that exits here takes the site off the air.
KIND="${TUNER:-}"
if [ -z "$KIND" ]; then
    KIND="$(/usr/bin/python3 "$SLAVE_DIR/detect_tuner.py" 2>/dev/null || true)"
    [ -n "$KIND" ] || KIND=minitiouner
fi

case "$KIND" in
    knucker) SOURCE=knucker_source.py ;;
    *)       SOURCE=longmynd_source.py ;;
esac
echo "Tuner detected: $KIND (running $SOURCE)" >&2

# -u so output reaches the journal as it happens rather than when a
# buffer fills. Without it a crash can lose the lines explaining it.
exec /usr/bin/python3 -u "$SLAVE_DIR/$SOURCE" "${ARGS[@]}"
